---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ metadata.title }}</title>
    <description>{{ metadata.description }}</description>
    <link>{{ build.url }}</link>
    <atom:link href="{{ build.url }}/feed.xml" rel="self" type="application/rss+xml"/>
    <lastBuildDate>{{ collections.games[0].date | dateToISOString }}</lastBuildDate>
    {%- for game in collections.games | limit(10) %}
    <item>
      <title>{{ game.data.title }}</title>
      <description>{{ game.data.description | striptags }}</description>
      <pubDate>{{ game.date | dateToISOString }}</pubDate>
      <link>{{ build.url }}{{ game.url }}</link>
      <guid isPermaLink="true">{{ build.url }}{{ post.url }}</guid>
    </item>
    {%- endfor %}
  </channel>
</rss>
