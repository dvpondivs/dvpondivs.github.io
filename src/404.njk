---
layout: layouts/base.njk
title: Page Not Found
description: Oops! Looks like you've wandered into uncharted territory.
permalink: /404.html
eleventyExcludeFromCollections: true
---
{% from "_components/index.njk" import button %}

<section class="section flex-1 flex items-center justify-center min-h-[60vh]">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      {# Content side #}
      <div class="order-1 lg:order-2 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-primary-100 text-primary-800 rounded-full text-sm font-medium mb-4 hc:bg-white hc:text-primary-950 hc:ring-1 hc:ring-primary-800">
          <img src="/favicon-96x96.png" alt="" width="16" height="16" class="w-4 h-4" eleventy:ignore>
          <span>Error 404</span>
        </div>

        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-zinc-900 mb-4">
          Oops!
        </h1>

        <h2 class="text-xl md:text-2xl font-medium text-zinc-600 mb-6 hc:text-zinc-700">
          This page pulled a disappearing act
        </h2>

        <p class="text-lg text-zinc-600 max-w-md mx-auto lg:mx-0 mb-8 hc:text-zinc-700">
          The page you're looking for doesn't exist, was moved, or is just playing hide and seek.
        </p>

        <div class="flex flex-wrap justify-center lg:justify-start gap-4">
          {{ button({
            text: "Take Me Home",
            url: "/",
            variant: "primary",
            size: "lg"
          }) }}

          {{ button({
            text: "Browse Games",
            url: "/games/",
            variant: "outline"
          }) }}
        </div>
      </div>
    </div>
  </div>
</section>
