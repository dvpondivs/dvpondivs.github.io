{
  "name": "dvpondivs.github.io",
  "version": "1.0.0",
  "description": "a static 11ty app with Nunjucks, Tailwind CSS, and Alpine.js",
  "type": "module",
  
  "scripts": {
    "clean": "rimraf ./public ./.cache",
    "dev": "npm run start",
    "start": "cross-env ELEVENTY_ENV=development npm-run-all --parallel watch:*",
    "build": "cross-env ELEVENTY_ENV=production NODE_ENV=production npm-run-all --serial build:js build:css build:11ty postbuild",
    "watch:11ty": "eleventy --serve --quiet",
    "build:11ty": "eleventy",
    "watch:js": "esbuild ./src/assets/js/main.js --outfile=./public/assets/js/main.js --bundle --watch --sourcemap",
    "build:js": "esbuild ./src/assets/js/main.js --outfile=./public/assets/js/main.js --bundle --minify",
    "watch:css": "npx @tailwindcss/cli -i ./src/assets/css/main.css -o ./public/assets/css/main.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./src/assets/css/main.css -o ./public/assets/css/main.css --minify",
    "lint": "eslint .",
    "postbuild": "npm-run-all --parallel postbuild:*",
    "postbuild:pagefind": "pagefind --site ./public",
    "format": "prettier --write ."
  },
  "homepage": "https://github.com/dvpondivs/dvpondivs.github.io#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvpondivs/dvpondivs.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/dvpondivs/dvpondivs.github.io/issues"
  },
  "keywords": [
    "11ty",
    "eleventy",
    "nunjucks",
    "tailwindcss",
    "alpinejs"
  ],
  "author": "camjm",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-img": "^7.0.0",
    "@alpinejs/collapse": "^3.15.9",
    "@alpinejs/intersect": "^3.15.9",
    "@tailwindcss/cli": "^4.2.2",
    "alpinejs": "^3.15.9",
    "cross-env": "^10.1.0",
    "eleventy-plugin-phosphoricons": "^2.0.0",
    "eleventy-plugin-speculation-rules": "^2.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.1.0",
    "html-minifier-terser": "^7.2.0",
    "npm-run-all": "^4.1.5",
    "pagefind": "^1.4.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "rimraf": "^6.1.3",
    "yaml": "^2.8.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
